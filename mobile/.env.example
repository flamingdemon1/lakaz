# mobile/.env.example - copy to mobile/.env (never commit .env)
# Restart Expo after changing. There is no USE_MOCK switch any more: the app uses SIMULATED sample data
# only when the two Supabase values below are set to empty strings.

# The shared Lakaz Supabase project is used by default. Uncomment both lines
# for sample mode, or set both to override the project. Use a publishable key only.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
