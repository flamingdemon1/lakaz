# mobile/.env.example - copy to mobile/.env (never commit .env)
# Laptop IP on the phone hotspot (run ipconfig). Restart Expo after changing.
EXPO_PUBLIC_API_URL=http://192.168.43.20:3000
# true = SIMULATED data, no backend needed. false = use the real backend.
EXPO_PUBLIC_USE_MOCK=true

# Supabase (help alerts + acknowledge). Ask Shihad for the values; leave empty to use SAMPLE help alerts.
# Only the anon/publishable key goes here - NEVER the service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
